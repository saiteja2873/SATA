# Environment Configuration for Smart Tourism Assistant

# Gemini API (Required for embeddings and LLM features)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=tourism_db

# Qdrant Configuration (Vector Database)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=places_embeddings

# PostgreSQL (for user auth, if using)
# DATABASE_URL=postgresql://user:password@localhost:5432/tourism

# Server Configuration
NODE_ENV=development
PORT=5000
